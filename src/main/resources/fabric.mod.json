{
  "schemaVersion": 1,
  "id": "portable_tables",
  "version": "${version}",

  "name": "Portable Tables",
  "description": "A mod thats adds portable workbench's",
  "authors": [
    "AlphaMode"
  ],

  "license": "MIT",
  "icon": "assets/portable_tables/stationapi/textures/item/portable_crafting_table.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "me.alphamode.portabletables.PortableTables"
    ],
    "stationapi:event_bus": [
      "me.alphamode.portabletables.PortableTables",
      "me.alphamode.portabletables.network.PortablePackets"
    ],
    "stationapi:event_bus_client": [
      "me.alphamode.portabletables.client.PortableTablesClient"
    ],
    "gcapi3": [
      "me.alphamode.portabletables.PortableTables"
    ]
  },
  "mixins": [
    "portable_tables.mixins.json"
  ],
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_54": [
        "me/alphamode/portabletables/ext/PlayerExt"
      ],
      "net/minecraft/class_240": [
        "me/alphamode/portabletables/ext/PacketListenerExt"
      ]
    }
  },

  "depends": {
    "minecraft": "1.0.0-beta.7.3"
  }
}
